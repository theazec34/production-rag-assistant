# Credential-free default: deterministic sentence extraction, not an LLM.
RAG_PROVIDER=extractive
RAG_MINIMUM_RETRIEVAL_SCORE=0.25
RAG_CHUNK_SIZE_WORDS=100
RAG_CHUNK_OVERLAP_WORDS=20

# Optional OpenAI-compatible hosted or local endpoint.
# RAG_PROVIDER=openai-compatible
# RAG_PROVIDER_BASE_URL=http://localhost:11434/v1
# RAG_PROVIDER_MODEL=your-model-name
# RAG_PROVIDER_API_KEY=
# RAG_PROVIDER_TIMEOUT_SECONDS=15
